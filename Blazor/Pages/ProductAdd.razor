@page "/product-add"
@using Blazor.Models

<h3>ProductAdd</h3>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">Add New Product</h4>
                </div>

                <div class="card-body p-4">

                    <EditForm Model="@productAddModel" OnValidSubmit="@HandleSave">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-3">
                            <label for="productName" class="form-label fw-semibold">
                                Product Name
                            </label>

                            <InputText id="productName"
                                       class="form-control"
                                       @bind-Value="@productAddModel.ProductName"
                                       placeholder="Enter product name" />

                            <ValidationMessage For="@(() => productAddModel.ProductName)"
                                               class="text-danger small" />
                        </div>

                        <div class="mb-3">
                            <label for="productDescription" class="form-label fw-semibold">
                                Product Description
                            </label>

                            <InputText id="productDescription"
                                       class="form-control"
                                       @bind-Value="@productAddModel.Description"
                                       placeholder="Enter product description" />

                            <ValidationMessage For="@(() => productAddModel.Description)"
                                               class="text-danger small" />
                        </div>

                        <div class="mb-4">
                            <label for="categoryId" class="form-label fw-semibold">
                                Category
                            </label>

                            <InputSelect id="categoryId"
                                         class="form-select"
                                         @bind-Value="@productAddModel.CategoryId">

                                <option value="0">Choose category</option>
                                <option value="1">Beverages</option>
                                <option value="2">Condiments</option>

                            </InputSelect>

                            <ValidationMessage For="@(() => productAddModel.CategoryId)"
                                               class="text-danger small" />
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="button"
                                    class="btn btn-outline-secondary">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                <i class="bi bi-plus-circle me-1"></i>
                                Add Product
                            </button>
                        </div>

                    </EditForm>

                </div>
            </div>

        </div>
    </div>
</div>
@code {
    ProductAddModel productAddModel = new ProductAddModel();


    private void HandleSave()
    {
        Console.WriteLine($"Product Name: {productAddModel.ProductName} Added");
    }

}
