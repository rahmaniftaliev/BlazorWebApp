@page "/todo"
@inject HttpClient Http
@inject IApiService ApiService
@using Blazor.Models
@using Blazor.Services


<h1>Todo List</h1>

@if (todoItems == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
            
        <thead>
            <tr>
               <th>Id</th>
               <th>UserId</th>
               <th>Title</th>
               <th>Completed</th>
               
            </tr>
        </thead>
         <tbody>
            @foreach (var item in todoItems)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UserId</td>
                    <td>@item.Title</td>
                    <td>@item.IsCompleted</td>
                </tr>
            }
         </tbody>   
    </table>
}




@code {

    TodoItem[]? todoItems;

    protected override async Task OnInitializedAsync()
    {  
        todoItems = await ApiService.GetTodos();
    }


}
